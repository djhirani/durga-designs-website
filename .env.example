# ================================================================
# DURGA DESIGNS — ENVIRONMENT VARIABLES (EXAMPLE / TEMPLATE ONLY)
# ================================================================
# Copy this file to ".env" for local development with the Netlify CLI
# (`netlify dev`) and fill in your own STRIPE TEST MODE keys.
#
# DO NOT commit a real ".env" file.
# DO NOT put live/production Stripe keys here or anywhere in this repo.
# DO NOT put STRIPE_SECRET_KEY in any frontend file (HTML/JS/config.js).
#
# Get test-mode keys from: https://dashboard.stripe.com/test/apikeys
# (they start with "pk_test_" and "sk_test_")
# ================================================================

# Publishable key — safe to expose to the browser, TEST MODE only (pk_test_...)
STRIPE_PUBLISHABLE_KEY=pk_test_REPLACE_ME

# Secret key — SERVER-SIDE ONLY. Never expose in frontend code. TEST MODE only (sk_test_...)
STRIPE_SECRET_KEY=sk_test_REPLACE_ME

# Webhook signing secret — used by netlify/functions/stripe-webhook.js to
# verify that incoming webhook requests genuinely came from Stripe (whsec_...).
# When testing locally with the Stripe CLI, run:
#   stripe listen --forward-to localhost:8888/.netlify/functions/stripe-webhook
# The CLI will print a "whsec_..." value for you to paste here.
STRIPE_WEBHOOK_SECRET=whsec_REPLACE_ME

# Base URL of the site, used to build Stripe success/cancel redirect URLs.
# Use your local dev URL while testing (e.g. http://localhost:8888 with `netlify dev`).
SITE_URL=http://localhost:8888

# ----------------------------------------------------------------
# Supabase (Stage 6) — production-intended order storage.
# SERVER-SIDE ONLY. See docs/supabase-setup.md for full setup steps.
#
# DO NOT put any of these in frontend code (HTML/JS/config.js).
# DO NOT commit real values — these are placeholders only.
#
# If these are left unset (or unset locally), the Stripe webhook
# automatically falls back to the DEV/TEST-ONLY local file order store
# from Stage 5 (see netlify/functions/lib/order-store.js) and logs a
# clear developer message — it will NOT crash the customer flow.
# ----------------------------------------------------------------

# Your Supabase project URL, e.g. https://xxxxxxxxxxxx.supabase.co
SUPABASE_URL=https://REPLACE_ME.supabase.co

# Anonymous/public key — safe-ish for browser use in general Supabase
# projects, but THIS PROJECT'S FRONTEND DOES NOT USE SUPABASE AT ALL.
# Kept here only as a placeholder for completeness/future stages.
SUPABASE_ANON_KEY=REPLACE_ME

# Service role key — SERVER-SIDE ONLY, NEVER expose in frontend code.
# This key BYPASSES Row Level Security entirely — treat it like a
# database root password. Used only by netlify/functions/lib/supabase-client.js.
SUPABASE_SERVICE_ROLE_KEY=REPLACE_ME

# ----------------------------------------------------------------
# Admin dashboard (Stage 7) — TEMPORARY shared-token gate.
# SERVER-SIDE ONLY. See docs/supabase-setup.md / docs/order-flow-notes.md.
#
# This is a stop-gap, not a real authentication system. Generate a
# long random string for local testing, e.g.:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
#
# DO NOT commit a real value. The admin frontend (admin/**) asks
# whoever is testing it to paste this token; it is kept only in
# sessionStorage for that browser tab and sent as a request header —
# never written to any file, never logged.
# ----------------------------------------------------------------
ADMIN_ACCESS_TOKEN=REPLACE_ME_WITH_A_LONG_RANDOM_STRING
